    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.1.0",
    "jsdom": "30.1.1",
    "lefthook": "2.1.10",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.57.1",
    "vite": "8.2.0",
    "vitest": "5.0.3"
  }
